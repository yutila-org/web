---
// src/layouts/SoftwareWireframeLayout.astro
interface Props {
	title?: string;
}

const { title = "Software Product - Architectural Wireframe" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<style is:global>
			:root {
				--bg-base: #050505;
				--bg-surface: #0a0a0c;
				--border-stark: #2a2a2e;
				--block-dark: #1f1f22;
				--block-light: #3f3f46;
				--block-highlight: #e4e4e7;
				--font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				background-color: var(--bg-base);
				color: var(--block-highlight);
				font-family: var(--font-mono);
				line-height: 1.5;
				min-height: 100vh;
				display: flex;
				justify-content: center;
				padding: 2rem;
			}

			/* Container matching enterprise-grade schematic constraints */
			.wireframe-container {
				width: 100%;
				max-width: 1200px;
				border: 1px solid var(--border-stark);
				background-color: var(--bg-surface);
				display: flex;
				flex-direction: column;
			}

			/* Generic block to represent text/elements */
			.wf-block {
				background-color: var(--block-light);
				border-radius: 0; /* Strict geometric */
			}

			/* -----------------------------------------
			   Top: Ultra-thin navigation bar
			----------------------------------------- */
			.wf-nav {
				height: 48px;
				border-bottom: 1px solid var(--border-stark);
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0 1.5rem;
			}

			.wf-logo {
				width: 40px;
				height: 24px;
				background-color: var(--block-highlight);
			}

			.wf-nav-cta {
				width: 80px;
				height: 24px;
				border: 1px solid var(--block-highlight);
				background-color: transparent;
			}

			/* -----------------------------------------
			   Main Content Area
			----------------------------------------- */
			.wf-main {
				flex: 1;
				display: flex;
				flex-direction: column;
			}

			/* -----------------------------------------
			   Hero Section
			----------------------------------------- */
			.wf-hero {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 4rem;
				padding: 6rem 3rem;
				border-bottom: 1px solid var(--border-stark);
			}

			.wf-hero-left {
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 1.5rem;
			}

			/* Typography placeholders */
			.wf-title-1 { width: 85%; height: 48px; }
			.wf-title-2 { width: 65%; height: 48px; }
			
			.wf-subtitle-container {
				display: flex;
				gap: 1rem;
				margin-top: 1rem;
			}
			.wf-subtitle-1 { width: 30%; height: 16px; background-color: var(--block-dark); }
			.wf-subtitle-2 { width: 40%; height: 16px; background-color: var(--block-dark); }

			.wf-hero-cta {
				margin-top: 2rem;
				width: 160px;
				height: 48px;
				background-color: var(--block-highlight);
			}

			/* Geometric block / Terminal UI */
			.wf-hero-right {
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.wf-terminal-ui {
				width: 100%;
				aspect-ratio: 4/3;
				border: 1px solid var(--border-stark);
				background-color: var(--bg-base);
				display: flex;
				flex-direction: column;
			}

			.wf-terminal-header {
				height: 32px;
				border-bottom: 1px solid var(--border-stark);
				display: flex;
				align-items: center;
				padding: 0 1rem;
				gap: 0.5rem;
			}

			.wf-terminal-dot {
				width: 8px;
				height: 8px;
				background-color: var(--block-dark);
			}

			.wf-terminal-body {
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.wf-term-line-1 { width: 40%; height: 12px; background-color: var(--block-dark); }
			.wf-term-line-2 { width: 70%; height: 12px; background-color: var(--block-dark); }
			.wf-term-line-3 { width: 55%; height: 12px; background-color: var(--block-dark); }

			/* -----------------------------------------
			   Middle Section: 3-column grid
			----------------------------------------- */
			.wf-features {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				border-bottom: 1px solid var(--border-stark);
			}

			.wf-card {
				padding: 4rem 3rem;
				border-right: 1px solid var(--border-stark);
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			.wf-card:last-child {
				border-right: none;
			}

			.wf-icon-box {
				width: 48px;
				height: 48px;
				border: 1px solid var(--block-light);
				background-color: transparent;
				margin-bottom: 1rem;
			}

			.wf-card-title { width: 60%; height: 24px; }
			.wf-card-desc-1 { width: 100%; height: 12px; background-color: var(--block-dark); }
			.wf-card-desc-2 { width: 85%; height: 12px; background-color: var(--block-dark); }
			.wf-card-desc-3 { width: 40%; height: 12px; background-color: var(--block-dark); }

			/* -----------------------------------------
			   Lower Section: Terminal code snippet
			----------------------------------------- */
			.wf-lower {
				padding: 6rem 3rem;
				display: flex;
				justify-content: center;
				border-bottom: 1px solid var(--border-stark);
			}

			.wf-snippet-box {
				width: 100%;
				max-width: 800px;
				border: 1px solid var(--border-stark);
				padding: 1.5rem 2rem;
				display: flex;
				align-items: center;
				gap: 1rem;
				background-color: var(--bg-base);
			}

			.wf-prompt {
				color: var(--block-light);
				font-size: 1.25rem;
				font-weight: bold;
				user-select: none;
			}

			.wf-snippet-code {
				width: 60%;
				height: 16px;
				background-color: var(--block-light);
			}

			/* -----------------------------------------
			   Footer
			----------------------------------------- */
			.wf-footer {
				height: 80px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0 3rem;
			}

			.wf-footer-links {
				display: flex;
				gap: 2rem;
			}

			.wf-footer-link { width: 48px; height: 12px; background-color: var(--block-dark); }
			
			.wf-copyright { width: 120px; height: 12px; background-color: var(--block-dark); }

			/* Responsive */
			@media (max-width: 900px) {
				.wf-hero {
					grid-template-columns: 1fr;
					padding: 4rem 2rem;
				}
				.wf-features {
					grid-template-columns: 1fr;
				}
				.wf-card {
					border-right: none;
					border-bottom: 1px solid var(--border-stark);
				}
				.wf-card:last-child {
					border-bottom: none;
				}
				.wf-lower {
					padding: 4rem 2rem;
				}
				.wf-footer {
					flex-direction: column;
					justify-content: center;
					gap: 1rem;
					height: auto;
					padding: 2rem;
				}
			}
		</style>
	</head>
	<body>
		<div class="wireframe-container">
			
			<!-- Top: Ultra-thin navigation bar -->
			<header class="wf-nav">
				<div class="wf-logo"></div>
				<div class="wf-nav-cta"></div>
			</header>

			<!-- Main Content Placeholder -->
			<main class="wf-main">
				<slot />
			</main>

			<!-- Footer -->
			<footer class="wf-footer">
				<div class="wf-footer-links">
					<div class="wf-block wf-footer-link"></div>
					<div class="wf-block wf-footer-link"></div>
					<div class="wf-block wf-footer-link"></div>
				</div>
				<div class="wf-block wf-copyright"></div>
			</footer>

		</div>
	</body>
</html>
