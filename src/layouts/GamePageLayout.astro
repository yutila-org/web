---
import Layout from './Layout.astro';

interface Props {
  title: string;
  primaryColor?: string;
  secondaryColor?: string;
  bgDark?: string;
}

// Customization variables at the top for easy changing
const { 
  title, 
  primaryColor = '#5EBD3E', // Default Yutila Green
  secondaryColor = '#F78200', // Default Yutila Orange
  bgDark = '#171717' // Default Yutila Dark
} = Astro.props;

// We use CSS variables to pass these down to the styles
const themeVariables = `
  --theme-primary: ${primaryColor};
  --theme-secondary: ${secondaryColor};
  --theme-bg-dark: ${bgDark};
`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={`Upcoming Game: ${title}`} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} - Yutila Games</title>
	</head>
	<body style={themeVariables}>
		<header class="game-header">
			<nav>
				<a href="/" class="logo">
					<img src="/favicon.svg" alt="Yutila" style="height: 40px; width: auto;" />
				</a>
				<div class="links">
					<a href="/software">Software</a>
					<a href="/games">Games</a>
					<a href="/blog">Blog</a>
				</div>
			</nav>
		</header>

		<!-- Thematic CSS Background Pattern -->
		<div class="game-background">
			<div class="grid-overlay"></div>
			<div class="gradient-blobs"></div>
		</div>

		<main class="game-main">
			<slot />
		</main>

		<footer class="game-footer">
			<div class="footer-links">
				<a href="/contact">Contact</a>
				<a href="/about">About</a>
				<a href="/governance">Governance</a>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	*, *::before, *::after {
		box-sizing: border-box;
	}

	html, body {
		margin: 0;
		padding: 0;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		background-color: var(--theme-bg-dark);
		color: #FAFAFA;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		position: relative;
		overflow-x: hidden;
	}

	/* Background and Thematic Patterns */
	.game-background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		pointer-events: none;
		overflow: hidden;
	}

	.grid-overlay {
		position: absolute;
		inset: 0;
		background-image: 
			linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
		background-size: 50px 50px;
		background-position: center center;
		mask-image: radial-gradient(ellipse at center, black 20%, transparent 80%);
		-webkit-mask-image: radial-gradient(ellipse at center, black 20%, transparent 80%);
	}

	.gradient-blobs {
		position: absolute;
		width: 100%;
		height: 100%;
		background: 
			radial-gradient(circle at 15% 50%, color-mix(in srgb, var(--theme-primary) 15%, transparent), transparent 40%),
			radial-gradient(circle at 85% 30%, color-mix(in srgb, var(--theme-secondary) 15%, transparent), transparent 40%);
		filter: blur(80px);
		opacity: 0.8;
		animation: pulse-blobs 10s ease-in-out infinite alternate;
	}

	@keyframes pulse-blobs {
		0% { transform: scale(1); opacity: 0.6; }
		100% { transform: scale(1.1); opacity: 0.9; }
	}

	/* Navigation matches layout but with transparent base */
	.game-header {
		border-bottom: 1px solid rgba(255,255,255,0.05);
		padding: 1.5rem 0;
		position: relative;
		z-index: 10;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
	}

	.game-header::after {
		content: '';
		position: absolute;
		bottom: -1px;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--theme-primary), var(--theme-secondary), transparent);
	}

	nav {
		max-width: 1440px;
		width: 100%;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.links {
		display: flex;
		gap: 2rem;
	}

	a {
		color: #A1A1AA;
		text-decoration: none;
		transition: color 0.2s ease;
		font-size: 0.95rem;
	}

	a:hover {
		color: #FAFAFA;
	}

	.game-main {
		flex: 1;
		width: 100%;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		position: relative;
		z-index: 1;
	}

	.game-footer {
		border-top: 1px solid rgba(255,255,255,0.05);
		padding: 2rem 0;
		margin-top: auto;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		position: relative;
		z-index: 10;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
	}
	
	@media (max-width: 768px) {
		nav {
			flex-direction: column;
			gap: 1rem;
		}
		.links {
			flex-wrap: wrap;
			justify-content: center;
			gap: 1rem;
		}
	}
</style>
