---
// src/layouts/MerlinDocsLayout.astro
import '../styles/merlin-docs.css';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
  headings?: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title} | Merlin Docs</title>
  </head>
  <body>
    <header>
      <div class="header-left">
        <a href="/software/merlin" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 8px;">
          <img src="/icons/merlin.svg" alt="Merlin" style="width: 16px; height: 22px; object-fit: contain;" />
          <strong>Merlin Documentation</strong>
        </a>
      </div>
      <button id="search-trigger" class="search-btn" title="Search (Ctrl+K)" aria-label="Search">
        <span>Search</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
      </button>
      <div class="nav-right" style="display: flex; gap: 1rem; align-items: center;">
        <a href="/software/merlin" class="github-link">Merlin</a>
        <a href="/software" class="github-link">Software</a>
        <a href="https://github.com/yutila-org/merlin" class="github-link">GitHub</a>
      </div>
    </header>
    <hr />
    
    <div class="layout-container">
      <aside class="sidebar">
        <nav>
          <details open>
            <summary>Overview</summary>
            <ul>
              <li><a href="/docs/merlin/overview" class={currentPath.endsWith('/overview') || currentPath.endsWith('/overview/') ? 'active' : ''}>Introduction</a></li>
              <li><a href="/docs/merlin/overview/why-d" class={currentPath.endsWith('/why-d') || currentPath.endsWith('/why-d/') ? 'active' : ''}>Design</a></li>
            </ul>
          </details>

          <details open>
            <summary>Getting Started</summary>
            <ul>
              <li><a href="/docs/merlin/getting-started" class={currentPath.includes('/docs/merlin/getting-started') ? 'active' : ''}>Getting Started</a></li>
            </ul>
          </details>

          <details open>
            <summary>Commands</summary>
            <ul>
              <li><a href="/docs/merlin/commands" class={currentPath.includes('/docs/merlin/commands') ? 'active' : ''}>CLI</a></li>
            </ul>
          </details>

          {headings && headings.length > 0 && (
            <div style="margin-top: 2rem; border-top: 1px dashed #444; padding-top: 1rem;">
              <h3 style="font-size: 1em; color: #aaa; margin-bottom: 0.8em; text-transform: uppercase;">On this page</h3>
              <ul style="list-style-type: none; padding-left: 0;">
                {headings.map((heading) => (
                  <li style={`margin-left: ${Math.max(0, heading.depth - 2) * 15}px; font-size: 0.9em; margin-bottom: 0.5em;`}>
                    <a href={`#${heading.slug}`} style="color: #888; text-decoration: none;">{heading.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}

        </nav>
      </aside>

      <main class="content">
        <article>
          <h1>{frontmatter.title}</h1>
          <slot />
        </article>
      </main>
    </div>

    <!-- Search Modal -->
    <div id="search-overlay" class="search-overlay" style="display: none;">
      <div class="search-modal">
        <div class="search-input-row">
          <input id="search-input" type="text" placeholder="Search Merlin documentation" autocomplete="off" spellcheck="false" />
          <kbd>Esc</kbd>
        </div>
        <ul id="search-results" class="search-results"></ul>
        <div id="search-empty" class="search-empty">No results found</div>
      </div>
    </div>

    <script is:inline src="/search.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const detailsElements = document.querySelectorAll('.sidebar details');
        const prefix = window.location.pathname.includes('camelot') ? 'camelot' : 'merlin';
        
        detailsElements.forEach((details) => {
          const summary = details.querySelector('summary');
          if (!summary) return;
          
          const key = `docs-details-${prefix}-${summary.textContent.trim().replace(/\s+/g, '-').toLowerCase()}`;
          
          const savedState = localStorage.getItem(key);
          if (savedState !== null) {
            if (savedState === 'open') {
              details.setAttribute('open', '');
            } else {
              details.removeAttribute('open');
            }
          }
          
          details.addEventListener('toggle', () => {
            localStorage.setItem(key, details.hasAttribute('open') ? 'open' : 'closed');
          });
        });
      });
    </script>
  </body>
</html>
