---
// src/layouts/CamelotDocsLayout.astro
import '../styles/camelot-docs.css';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
  headings?: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{frontmatter.title} | Camelot Docs</title>
  </head>
  <body>
    <header>
      <div class="header-left">
        <a href="/software/camelot" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 8px;">
          <svg viewBox="0 0 210 297" fill="none" style="width: 16px; height: 22px;">
            <g transform="translate(-3.8884891,5.3710162)">
              <path style="opacity:1;fill:#e03131;stroke:none;stroke-width:0" d="m 95.640424,78.255634 c 0,0 -16.863019,-38.11792 -4.986458,-49.864681 4.978354,-4.923954 20.052404,-12.373537 27.702114,-10.010498 5.1397,1.587687 2.84444,12.118304 7.20315,13.888865 4.0265,1.635616 13.09112,-3.931062 17.26603,-1.842825 5.87895,2.940582 7.19453,13.274511 12.08746,17.945705 4.94431,4.720245 22.70992,8.790902 27.38553,12.816748 5.72005,4.925137 -1.92466,9.783212 0.60534,15.681549 15.15987,35.342913 3.49041,70.019203 -4.15538,105.823903 -7.37218,34.52345 0.71681,-18.37755 -7.06446,-42.79033 -1.54123,-4.83543 -12.63776,-12.35428 -14.01509,-17.32797 -2.13053,-7.69357 6.64626,-17.58733 3.51453,-24.399973 -2.4024,-5.22612 -11.81547,-2.95144 -14.51677,-7.46498 -5.27041,-8.806232 -2.70545,-21.695713 -10.5802,-24.367634 -7.68824,-2.608627 -15.79049,16.62156 -15.79049,16.62156 z" />
              <path style="opacity:1;fill:#ffffff;stroke-width:0.398811" d="m 27.492047,131.72164 c 3.947201,-25.95562 26.715737,-44.168003 56.790317,-54.574112 28.937776,-10.012778 43.352126,5.645621 53.188996,19.945859 34.18626,49.697993 -7.16077,46.464633 -1.66217,68.702443 5.68578,22.99477 43.7609,39.95248 34.62824,62.0538 -15.06223,36.4511 -85.499161,54.19552 -114.965764,27.97962 -8.278098,-7.36487 -1.753025,-18.78655 4.048759,-32.99275 5.689863,-13.93216 23.948407,-26.8826 23.396497,-36.35063 -0.287428,-4.93085 -15.106101,13.42858 -31.984261,-2.17683 -10.297185,-9.52069 -11.74557,-18.74632 -17.998276,-32.02054 -1.338698,-2.84201 54.191939,-23.89417 53.950354,-26.92508 -0.123042,-1.54375 -59.636969,7.96452 -59.392692,6.35822 z" />
            </g>
          </svg>
          <strong>Camelot Documentation</strong>
        </a>
      </div>
      <nav class="header-nav">
        <div id="search-trigger" class="search-trigger">
          Search... <kbd>Ctrl+K</kbd>
        </div>
        <a href="/software/camelot">Home</a> | 
        <a href="https://github.com/yutila-org/camelot">GitHub</a>
      </nav>
    </header>
    <hr />
    
    <div class="layout-container">
      <aside class="sidebar">
        <nav>
          <details open>
            <summary>Overview</summary>
            <ul>
              <li><a href="/docs/camelot/overview" class={currentPath.endsWith('/overview') || currentPath.endsWith('/overview/') ? 'active' : ''}>Introduction</a></li>
              <li><a href="/docs/camelot/overview/architecture" class={currentPath.includes('/overview/architecture') ? 'active' : ''}>Architecture</a></li>
              <li><a href="/docs/camelot/overview/memory" class={currentPath.includes('/overview/memory') ? 'active' : ''}>Memory Allocator</a></li>
            </ul>
          </details>

          <details open>
            <summary>Core Systems</summary>
            <ul>
              <li><a href="/docs/camelot/core/merlin" class={currentPath.includes('/core/merlin') ? 'active' : ''}>Merlin Build Engine</a></li>
              <li><a href="/docs/camelot/core/io" class={currentPath.includes('/core/io') ? 'active' : ''}>I/O Utilities</a></li>
            </ul>
          </details>

          {headings && headings.length > 0 && (
            <div style="margin-top: 2rem; border-top: 1px dashed #444; padding-top: 1rem;">
              <h3 style="font-size: 1em; color: #aaa; margin-bottom: 0.8em; text-transform: uppercase;">On this page</h3>
              <ul style="list-style-type: none; padding-left: 0;">
                {headings.map((heading) => (
                  <li style={`margin-left: ${Math.max(0, heading.depth - 2) * 15}px; font-size: 0.9em; margin-bottom: 0.5em;`}>
                    <a href={`#${heading.slug}`} style="color: #888; text-decoration: none;">{heading.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div style="margin-top: 3rem; text-align: left;">
            <a href="https://www.bestpractices.dev/projects/12919">
              <img src="/openssf-badge.svg" alt="OpenSSF Best Practices: Passing" style="height: 28px; vertical-align: middle;" />
            </a>
          </div>
        </nav>
      </aside>

      <main class="content">
        <article>
          <h1>{frontmatter.title}</h1>
          <slot />
        </article>
      </main>
    </div>

    <!-- Search Modal -->
    <div id="search-overlay" class="search-overlay" style="display: none;">
      <div class="search-modal">
        <div class="search-input-row">
          <input id="search-input" type="text" placeholder="Search Camelot documentation..." autocomplete="off" spellcheck="false" />
          <kbd>Esc</kbd>
        </div>
        <ul id="search-results" class="search-results"></ul>
        <div id="search-empty" class="search-empty">No results found.</div>
      </div>
    </div>

    <script is:inline src="/search.js"></script>
  </body>
</html>
