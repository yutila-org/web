---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Yutila - Software, Games, Hardware, and Infrastructure" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<nav>
				<a href="/" class="logo">
					<img src="/favicon.svg" alt="Yutila" style="height: 40px; width: auto;" />
				</a>
				<div class="links">
					<a href="/software">Software</a>
					<a href="/games">Games</a>
					<a href="/blog">Blog</a>
					<a href="/docs">Docs</a>
				</div>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<div class="footer-links">
				<a href="/contact">Contact</a>
                <a href="/about">About</a>
                <a href="/governance">Governance</a>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #171717;
		--text-color: #FAFAFA;
		--text-muted: #A1A1AA;
		--border-color: #27272A;
		--yutila-green: #5EBD3E;
		--yutila-yellow: #FFB900;
		--yutila-orange: #F78200;
		--yutila-red: #E23B38;
		--yutila-purple: #973999;
		--yutila-blue: #009CDF;
	}
	
	*, *::before, *::after {
		box-sizing: border-box;
	}

	html, body {
		margin: 0;
		padding: 0;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		background-color: var(--bg-color);
		color: var(--text-color);
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	header {
		border-bottom: 1px solid var(--border-color);
		padding: 1.5rem 0;
		position: relative;
	}

	header::after {
		content: '';
		position: absolute;
		bottom: -1px;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, var(--yutila-green), var(--yutila-yellow), var(--yutila-orange), var(--yutila-red), var(--yutila-purple), var(--yutila-blue));
	}

	nav {
		max-width: 1440px;
		width: 100%;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		display: flex;
		align-items: center;
		text-decoration: none;
	}

	.logo img {
		display: block;
	}

	.links {
		display: flex;
		gap: 2rem;
	}

	a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s ease;
		font-size: 0.95rem;
	}

	a:hover {
		color: var(--text-color);
	}

	main {
		flex: 1;
		max-width: 1440px;
		width: 100%;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	footer {
		border-top: 1px solid var(--border-color);
		padding: 2rem 0;
		margin-top: auto;
	}

	.footer-links {
		max-width: 1440px;
		width: 100%;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		gap: 1.5rem;
		justify-content: center;
	}

	.page-container {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		max-width: 1000px;
		margin: 0 auto;
	}

	.page-header {
		padding-top: 1rem;
	}

	.page-header h1 {
		font-size: clamp(3rem, 7vw, 4.5rem);
		font-weight: 800;
		line-height: 1.1;
		margin: 0 0 1rem 0;
		letter-spacing: -0.02em;
	}

	.page-subtitle {
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		color: var(--text-muted);
		max-width: 600px;
		line-height: 1.6;
		margin: 0;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-muted);
		font-size: 0.95rem;
		font-weight: 500;
		margin-bottom: 2rem;
		text-decoration: none;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.back-link:hover {
		color: var(--text-color);
		transform: translateX(-4px);
	}

	.glass-card {
		background: rgba(39, 39, 42, 0.4);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 16px;
		padding: 2rem;
		position: relative;
		overflow: hidden;
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.glass-card:hover {
		transform: translateY(-4px);
		border-color: rgba(255, 255, 255, 0.1);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
	}

	.card-glow {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--glow-color, rgba(255, 255, 255, 0.2)), transparent);
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.glass-card:hover .card-glow {
		opacity: 1;
	}

	@media (max-width: 768px) {
		main {
			padding: 2rem 1rem;
		}
		nav {
			flex-direction: column;
			gap: 1rem;
		}
		.links {
			flex-wrap: wrap;
			justify-content: center;
			gap: 1rem;
		}
		.glass-card {
			padding: 1.5rem;
		}
	}
</style>
