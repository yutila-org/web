---
// src/pages/software/merlin.astro
import '../../styles/merlin-docs.css';

const docFiles = Object.values(import.meta.glob('../docs/merlin/**/*.md', { eager: true }));
const features = docFiles.filter((f: any) => f.frontmatter?.title && f.frontmatter?.description);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Merlin</title>
        <style>
            .top-stripe {
                height: 4px;
                background-color: #a855f7;
                width: 100%;
                position: absolute;
                top: 0;
                left: 0;
            }
            .hero-section {
                display: flex;
                align-items: center;
                gap: 40px;
                margin-top: 2em;
                margin-bottom: 3em;
            }
            .hero-text {
                flex: 1;
            }

            .content-table {
                width: 100%;
                border-collapse: collapse;
                margin: 2em 0;
                border: 1px solid #333;
            }
            .content-table th, .content-table td {
                padding: 15px;
                border: 1px solid #333;
                text-align: left;
                vertical-align: top;
            }
            .content-table th {
                background-color: #1a1a1a;
                color: #fff;
                font-weight: bold;
                width: 25%;
            }
            .th-inner {
                display: flex;
                align-items: center;
                gap: 10px;
            }
            .info-box {
                background-color: #1a1a1a;
                border-left: 4px solid #a855f7;
                padding: 15px;
                margin: 2em 0;
            }
            @media (max-width: 768px) {
                .hero-section {
                    flex-direction: column;
                }
            }
        </style>
    </head>
    <body>
        <div class="top-stripe"></div>
        <header style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 2rem;">
                <a href="/software/merlin" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 8px;">
                    <img src="/icons/merlin.svg" alt="Merlin" style="width: 24px; height: 33px; object-fit: contain;" />
                    <strong>Merlin</strong>
                </a>
                <nav style="display: flex; gap: 1rem;">
                    <a href="https://github.com/yutila-org/merlin">Repository</a>
                    <a href="/docs/merlin/overview">Documentation</a>
                </nav>
            </div>
            <div>
                <a href="https://github.com/yutila-org/merlin/releases/latest" style="padding: 0.5rem 1rem; background: #c084fc; color: #fff; text-decoration: none; font-weight: bold; border-radius: 4px;">Download Release</a>
            </div>
        </header>
        <hr />

        <main>
            <div style="margin-bottom: 2rem;">
                <a href="/software" style="text-decoration: none; color: #aaa; display: flex; align-items: center; gap: 8px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
                    Back to Software
                </a>
            </div>
            <h1>Merlin</h1>
            <div style="margin-top: 1rem; margin-bottom: 2rem; display: flex; align-items: center; gap: 15px; background: #1a1a1a; padding: 10px 15px; border: 1px solid #333; width: fit-content;">
                <a href="https://www.bestpractices.dev/projects/12919" style="display: flex;">
                    <img src="/openssf-badge.svg" alt="OpenSSF Best Practices: Passing" style="height: 28px;" />
                </a>
                <span style="font-size: 0.85rem; color: #aaa;">OpenSSF certification verifies adherence to secure software development and supply chain practices.</span>
            </div>
            
            <div class="hero-section">
                <div class="hero-text">
                    <p>
                        Merlin is a powerful build engine designed to orchestrate the compilation of C and C++ projects. It provides strict compiler flags and seamless integration with frameworks like Camelot for modern, safe, and ergonomic development.
                    </p>
                </div>
            </div>

            <div style="display: flex; flex-wrap: wrap; gap: 2rem; margin-bottom: 3rem;">
                <div style="background: #1a1a1a; padding: 2rem; border: 1px solid #333; flex: 2; min-width: 350px;">
                    <h3 style="display: flex; align-items: center; gap: 10px; margin-top: 0;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        Getting Merlin
                    </h3>
                    <p style="font-size: 0.95rem; color: #aaa;">
                        Execute the installation script to bootstrap the Merlin build engine and automatically bind it to your system environment.
                    </p>
                    <div style="margin-bottom: 1rem;">
                        <span style="font-size: 0.85rem; color: #aaa; text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 6px;"><img src="/icons/linux.svg" alt="Linux" width="14" height="14" style="vertical-align: middle; filter: brightness(0) invert(1); opacity: 0.7;" />macOS / Linux</span>
                        <pre style="background: #121212; padding: 1rem; border: 1px solid #333; overflow-x: auto; font-size: 0.85rem; margin-top: 0.5rem; margin-bottom: 1rem;">curl -sSL https://github.com/yutila-org/merlin/releases/latest/download/install.sh | bash</pre>
                        
                        <span style="font-size: 0.85rem; color: #aaa; text-transform: uppercase; letter-spacing: 0.05em; display: flex; align-items: center; gap: 6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.951-1.801"/></svg>Windows</span>
                        <pre style="background: #121212; padding: 1rem; border: 1px solid #333; overflow-x: auto; font-size: 0.85rem; margin-top: 0.5rem;">irm https://github.com/yutila-org/merlin/releases/latest/download/install.ps1 | iex</pre>
                    </div>
                    <p style="font-size: 0.95rem; color: #aaa; margin-top: 1rem;">
                        Once installed, restart your terminal and scaffold a new project:
                    </p>
                    <pre style="background: #121212; padding: 1rem; border: 1px solid #333; overflow-x: auto; font-size: 0.85rem;">merlin new my_project</pre>
                </div>

                <div style="background: #1a1a1a; padding: 2rem; border: 1px solid #333; flex: 1; min-width: 250px;">
                    <h3 style="display: flex; align-items: center; gap: 10px; margin-top: 0;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#c084fc" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                        Documentation
                    </h3>
                    <p style="font-size: 0.95rem; color: #aaa;">
                        Comprehensive manuals covering the build configuration, flags, and the Merlin build engine.
                    </p>
                    <a href="/docs/merlin/overview" style="display: inline-block; padding: 0.5rem 1rem; background: #c084fc; color: #fff; text-decoration: none; font-weight: bold; margin-top: 1rem;">
                        Read the Manual
                    </a>
                </div>
            </div>

            <h2>Features</h2>
            
            <table class="content-table" id="features-table">
                <tbody>
                    {features.map((feature: any, index) => (
                        <tr class="feature-row" style={index >= 3 ? "display: none;" : ""}>
                            <th>
                                <div class="th-inner">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" fill="#a855f7"></circle></svg>
                                    <a href={feature.url} style="color: inherit; text-decoration: none;">{feature.frontmatter.title}</a>
                                </div>
                            </th>
                            <td>{feature.frontmatter.description}</td>
                        </tr>
                    ))}
                </tbody>
            </table>
            
            {features.length > 3 && (
                <div id="pagination-controls" style="display: flex; justify-content: center; align-items: center; gap: 15px; margin-top: 1rem; margin-bottom: 2rem;">
                    <button id="prev-page" style="padding: 0.5rem 1rem; background: #1a1a1a; color: #fff; border: 1px solid #333; cursor: pointer;">&lt;</button>
                    <span id="page-info" style="color: #aaa; font-size: 0.9rem;"></span>
                    <button id="next-page" style="padding: 0.5rem 1rem; background: #1a1a1a; color: #fff; border: 1px solid #333; cursor: pointer;">&gt;</button>
                </div>
            )}

            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const rows = document.querySelectorAll('.feature-row');
                    if (rows.length === 0) return;
                    
                    const prevBtn = document.getElementById('prev-page');
                    const nextBtn = document.getElementById('next-page');
                    const pageInfo = document.getElementById('page-info');
                    
                    let currentPage = 0;
                    const itemsPerPage = 3;
                    const totalPages = Math.ceil(rows.length / itemsPerPage);
                    
                    function updatePagination() {
                        rows.forEach((row, index) => {
                            if (index >= currentPage * itemsPerPage && index < (currentPage + 1) * itemsPerPage) {
                                (row as HTMLElement).style.display = 'table-row';
                            } else {
                                (row as HTMLElement).style.display = 'none';
                            }
                        });
                        
                        if (pageInfo) {
                            pageInfo.textContent = `Page ${currentPage + 1} of ${totalPages}`;
                        }
                        
                        if (prevBtn) {
                            (prevBtn as HTMLButtonElement).disabled = currentPage === 0;
                            (prevBtn as HTMLElement).style.opacity = currentPage === 0 ? '0.5' : '1';
                        }
                        if (nextBtn) {
                            (nextBtn as HTMLButtonElement).disabled = currentPage === totalPages - 1;
                            (nextBtn as HTMLElement).style.opacity = currentPage === totalPages - 1 ? '0.5' : '1';
                        }
                    }
                    
                    if (prevBtn) {
                        prevBtn.addEventListener('click', () => {
                            if (currentPage > 0) {
                                currentPage--;
                                updatePagination();
                            }
                        });
                    }
                    
                    if (nextBtn) {
                        nextBtn.addEventListener('click', () => {
                            if (currentPage < totalPages - 1) {
                                currentPage++;
                                updatePagination();
                            }
                        });
                    }
                    
                    if (totalPages > 1) {
                        updatePagination();
                    }
                });
            </script>



        </main>

        <footer>
            <hr />
            <p>
                Distributed under the <a href="https://www.mozilla.org/en-US/MPL/2.0/">MPL 2.0</a><br/><br/>
            </p>
        </footer>
    </body>
</html>
