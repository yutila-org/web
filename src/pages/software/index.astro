---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Software - Yutila">
	<div class="page-container">
		<div class="page-header">
			<a href="/" class="back-link">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
				Back to Home
			</a>
			<h1>Software</h1>
			<p class="page-subtitle">Tools, applications and infrastructure maintained by the Yutila Project.</p>
		</div>

		<div class="search-container">
			<svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
			<input type="text" id="software-search" placeholder="Search software" aria-label="Search software">
		</div>

		<div class="software-grid">
			<a href="/software/stario" class="glass-card software-card" style="--glow-color: rgba(180, 190, 254, 0.5);">
				<div class="card-glow"></div>
				<div class="software-icon">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -2.4869e-14 17 15" width="32" height="32">
						<path d="M 9.5 11.4 C 9.5 9.5 8.3 7.5 5 7.5 L 3.8 7.5 A 1 1 0 0 1 3.7 0 L 10.5 0 C 8.5 0.5 7.5 1.9 7.5 3.6 C 7.5 5.5 8.7 7.5 12 7.5 L 13.2 7.5 A 1 1 0 0 1 13.3 15 L 6.5 15 C 8.5 14.5 9.5 13.1 9.5 11.4 M 0 11.5 A 1 1 0 0 0 7 11.5 A 1 1 0 0 0 0 11.5 M 17 3.5 A 1 1 0 0 0 10 3.5 A 1 1 0 0 0 17 3.5" fill="currentColor"/>
					</svg>
				</div>
				<div class="software-content">
					<h2>Stario</h2>
					<p>Android app launcher</p>
				</div>
				<div class="software-arrow">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</div>
			</a>
			<a href="/software/camelot" class="glass-card software-card" style="--glow-color: rgba(224, 49, 49, 0.5);">
				<div class="card-glow"></div>
				<div class="software-icon">
					<img src="/icons/camelot.svg" alt="Camelot" width="48" height="48" style="filter: brightness(0) invert(1);" />
				</div>
				<div class="software-content">
					<h2>Camelot</h2>
					<p>C framework</p>
				</div>
				<div class="software-arrow">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
				</div>
			</a>
		</div>
	</div>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const searchInput = document.getElementById('software-search') as HTMLInputElement;
		const cards = document.querySelectorAll('.software-card');

		if (searchInput) {
			searchInput.addEventListener('input', (e) => {
				const target = e.target as HTMLInputElement;
				const term = target.value.toLowerCase();
				cards.forEach((card: Element) => {
					const titleEl = card.querySelector('h2');
					const descEl = card.querySelector('p');
					const title = titleEl ? titleEl.textContent?.toLowerCase() || '' : '';
					const desc = descEl ? descEl.textContent?.toLowerCase() || '' : '';
					
					if (title.includes(term) || desc.includes(term)) {
						(card as HTMLElement).style.display = 'flex';
					} else {
						(card as HTMLElement).style.display = 'none';
					}
				});
			});
		}
	});
</script>

<style>
	.search-container {
		position: relative;
		margin-top: 2rem;
		width: 100%;
	}

	.search-icon {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-muted);
		pointer-events: none;
		z-index: 10;
	}

	#software-search {
		width: 100%;
		background: rgba(39, 39, 42, 0.4);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 12px;
		padding: 1rem 1rem 1rem 3rem;
		color: var(--text-color);
		font-family: inherit;
		font-size: 1rem;
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
		outline: none;
	}

	#software-search:focus {
		border-color: rgba(255, 255, 255, 0.2);
		box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.05);
	}

	#software-search::placeholder {
		color: var(--text-muted);
	}

	.software-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}

	.software-card {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		text-decoration: none;
		color: inherit;
		padding: 2rem;
	}

	.software-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 64px;
		height: 64px;
		background: rgba(255, 255, 255, 0.05);
		border-radius: 16px;
		color: var(--text-color);
		flex-shrink: 0;
	}

	.software-content {
		flex: 1;
	}

	.software-content h2 {
		margin: 0 0 0.5rem 0;
		font-size: 1.5rem;
		font-weight: 700;
	}

	.software-content p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.software-arrow {
		color: var(--text-muted);
		transition: transform 0.3s ease, color 0.3s ease;
	}

	.software-card:hover .software-arrow {
		transform: translateX(4px);
		color: var(--text-color);
	}

	@media (max-width: 600px) {
		.software-grid {
			grid-template-columns: 1fr;
		}
		.software-card {
			flex-direction: column;
			text-align: center;
			align-items: center;
		}
		.software-arrow {
			display: none;
		}
	}
</style>
