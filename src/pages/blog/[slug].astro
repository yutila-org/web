---
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const categoryColors: Record<string, string> = {
	Devlog: 'var(--yutila-green)',
	Publication: 'var(--yutila-blue)',
	Report: 'var(--yutila-orange)',
	Material: 'var(--yutila-purple)',
	Resource: 'var(--yutila-yellow)',
};
---

<Layout title={`${post.data.title} — Yutila`}>
	<article class="post-container">
		<BackLink href="/blog" label="Back to Blog" />

		<header class="post-header">
			<div class="post-meta">
				<span class="category-badge" style={`--cat-color: ${categoryColors[post.data.category]}`}>
					{post.data.category}
				</span>
				<time datetime={post.data.publishDate.toISOString()}>
					{post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
				</time>
			</div>
			<h1>{post.data.title}</h1>
			<div class="post-author">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
				{post.data.author}
			</div>
		</header>

		<div class="post-content">
			<Content />
		</div>
	</article>
</Layout>

<style>
	.post-container {
		max-width: 740px;
		margin: 0 auto;
	}

	.post-header {
		margin-bottom: 3rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border-color);
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
		font-size: 0.9rem;
	}

	.post-meta time {
		color: var(--text-muted);
	}

	.category-badge {
		background: color-mix(in srgb, var(--cat-color) 15%, transparent);
		border: 1px solid color-mix(in srgb, var(--cat-color) 30%, transparent);
		color: var(--cat-color);
		padding: 0.2rem 0.65rem;
		border-radius: 9999px;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.post-header h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 800;
		line-height: 1.15;
		margin: 0 0 1rem 0;
		letter-spacing: -0.02em;
	}

	.post-author {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.95rem;
		color: var(--text-muted);
	}

	.post-content {
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--text-muted);
	}

	.post-content :global(h2) {
		font-size: 1.6rem;
		font-weight: 700;
		color: var(--text-color);
		margin: 2.5rem 0 1rem 0;
	}

	.post-content :global(h3) {
		font-size: 1.3rem;
		font-weight: 600;
		color: var(--text-color);
		margin: 2rem 0 0.75rem 0;
	}

	.post-content :global(p) {
		margin: 0 0 1.25rem 0;
	}

	.post-content :global(a) {
		color: var(--yutila-blue);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.post-content :global(a:hover) {
		color: var(--text-color);
	}

	.post-content :global(code) {
		background: rgba(39, 39, 42, 0.6);
		padding: 0.15em 0.4em;
		border-radius: 4px;
		font-size: 0.9em;
	}

	.post-content :global(pre) {
		background: rgba(39, 39, 42, 0.6);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 1.25rem;
		overflow-x: auto;
		margin: 1.5rem 0;
	}

	.post-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.post-content :global(blockquote) {
		border-left: 3px solid var(--yutila-blue);
		margin: 1.5rem 0;
		padding: 0.5rem 1.25rem;
		color: var(--text-muted);
	}

	.post-content :global(ul), .post-content :global(ol) {
		padding-left: 1.5rem;
		margin: 1rem 0;
	}

	.post-content :global(li) {
		margin-bottom: 0.5rem;
	}

	.post-content :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 8px;
		margin: 1.5rem 0;
	}

	.post-content :global(hr) {
		border: none;
		border-top: 1px solid var(--border-color);
		margin: 2rem 0;
	}
</style>
