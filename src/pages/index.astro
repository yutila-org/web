---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Yutila">
	<section class="hero">
		<h1>Building the future of <br/> 
			<span class="letter-colors">
				<span style="color: var(--yutila-green);">T</span><span style="color: var(--yutila-yellow);">e</span><span style="color: var(--yutila-orange);">c</span><span style="color: var(--yutila-red);">h</span><span style="color: var(--yutila-purple);">n</span><span style="color: var(--yutila-blue);">o</span><span style="color: var(--yutila-green);">l</span><span style="color: var(--yutila-yellow);">o</span><span style="color: var(--yutila-orange);">g</span><span style="color: var(--yutila-red);">y</span>
			</span>
		</h1>
		<p>Yutila is an organization focused on software, games and in the future hardware.</p>
	</section>
</Layout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		min-height: 60vh;
		max-width: 800px;
	}

	h1 {
		font-size: clamp(3rem, 8vw, 5rem);
		font-weight: 800;
		line-height: 1.1;
		margin: 0 0 1.5rem 0;
		letter-spacing: -0.02em;
	}

	p {
		font-size: clamp(1.1rem, 2vw, 1.25rem);
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
		max-width: 600px;
	}


</style>
