---
import Layout from '../layouts/Layout.astro';

const icons = [
	{ name: 'rust', size: 44, top: 8, left: 12, dur: 50, delay: 0 },
	{ name: 'c', size: 38, top: 15, left: 78, dur: 44, delay: -5 },
	{ name: 'godotengine', size: 42, top: 35, left: 72, dur: 55, delay: -12 },
	{ name: 'linux', size: 46, top: 55, left: 8, dur: 48, delay: -8 },
	{ name: 'docker', size: 40, top: 70, left: 82, dur: 52, delay: -3 },
	{ name: 'gnubash', size: 36, top: 25, left: 45, dur: 46, delay: -15 },
	{ name: 'astro', size: 38, top: 80, left: 30, dur: 58, delay: -20 },
	{ name: 'cloudflare', size: 44, top: 45, left: 90, dur: 42, delay: -7 },
	{ name: 'githubactions', size: 36, top: 10, left: 55, dur: 53, delay: -10 },
	{ name: 'nixos', size: 40, top: 88, left: 65, dur: 47, delay: -18 },
	{ name: 'git', size: 34, top: 62, left: 50, dur: 51, delay: -14 },
	{ name: 'github', size: 42, top: 5, left: 35, dur: 56, delay: -22 },
	{ name: 'typescript', size: 40, top: 75, left: 15, dur: 51, delay: -9 },
	{ name: 'redis', size: 38, top: 85, left: 80, dur: 49, delay: -11 },
	{ name: 'nodedotjs', size: 44, top: 60, left: 95, dur: 57, delay: -4 },
	{ name: 'python', size: 34, top: 40, left: 18, dur: 43, delay: -17 },
	{ name: 'html5', size: 42, top: 30, left: 85, dur: 54, delay: -13 },
	{ name: 'javascript', size: 36, top: 50, left: 38, dur: 47, delay: -6 },
	{ name: 'go', size: 46, top: 65, left: 68, dur: 59, delay: -21 },
	{ name: 'markdown', size: 38, top: 12, left: 92, dur: 41, delay: -16 },
	{ name: 'd', size: 42, top: 20, left: 25, dur: 45, delay: -10 },
];
---

<Layout title="Yutila">
	<section class="hero">
		<div class="icon-field" aria-hidden="true">
			{icons.map((ic, i) => (
				<img
					class="float-icon"
					src={`/icons/${ic.name}.svg`}
					alt=""
					width={ic.size}
					height={ic.size}
					style={`top:${ic.top}%;left:${ic.left}%;width:${ic.size}px;height:${ic.size}px;animation-duration:${ic.dur}s;animation-delay:${ic.delay}s;`}
					loading="lazy"
					decoding="async"
				/>
			))}
		</div>
		<h1>
			<span class="letter-colors">
				<span style="color: var(--yutila-green);">Y</span><span style="color: var(--yutila-yellow);">u</span><span style="color: var(--yutila-orange);">t</span><span style="color: var(--yutila-red);">i</span><span style="color: var(--yutila-purple);">l</span><span style="color: var(--yutila-blue);">a</span>
			</span>
		</h1>
		<p>An independent community of developers crafting open-source software, interactive media, and hardware built on privacy, security, and digital freedom.</p>
		
		<div class="conformance-badge">
			<div class="badge-row">
				<a href="https://openchainproject.org" target="_blank" rel="noopener noreferrer" class="openchain-link" title="OpenChain ISO/IEC 5230 & 18974 Conformant">
					<img src="/icons/openchain-conformance.svg" alt="OpenChain Conformance Badge" width="110" height="110" />
				</a>
				<div class="logo-divider"></div>
				<div class="standards-logos">
					<a href="https://www.iso.org" target="_blank" rel="noopener noreferrer" title="International Organization for Standardization">
						<img src="/icons/iso-logo.svg" alt="ISO Logo" width="44" height="44" class="standard-logo" />
					</a>
					<a href="https://www.iec.ch" target="_blank" rel="noopener noreferrer" title="International Electrotechnical Commission">
						<img src="/icons/iec-logo.svg" alt="IEC Logo" width="44" height="44" class="standard-logo" />
					</a>
				</div>
			</div>
			<div class="badge-info">
				<span class="badge-title">ISO/IEC 5230 & 18974 Conformant</span>
				<span class="badge-desc">Security & license compliance</span>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		min-height: 60vh;
		max-width: 800px;
		position: relative;
		z-index: 1;
	}

	h1 {
		font-size: clamp(3rem, 8vw, 5rem);
		font-weight: 800;
		line-height: 1.1;
		margin: 0 0 1.5rem 0;
		letter-spacing: -0.02em;
	}

	p {
		font-size: clamp(1.1rem, 2vw, 1.25rem);
		color: var(--text-muted);
		line-height: 1.6;
		margin: 0;
		max-width: 600px;
		text-align: justify;
	}

	.conformance-badge {
		margin-top: 3.5rem;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.05);
		padding: 1.25rem 1.5rem;
		border-radius: 16px;
		backdrop-filter: blur(12px);
		box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
		transition: border-color 0.3s ease, background-color 0.3s ease;
	}

	.conformance-badge:hover {
		border-color: rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.03);
	}

	.badge-row {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.openchain-link img {
		display: block;
		transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.openchain-link:hover img {
		transform: scale(1.05) rotate(2deg);
	}

	.logo-divider {
		width: 1px;
		height: 48px;
		background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0));
	}

	.standards-logos {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.standard-logo {
		display: block;
		border-radius: 6px;
		transition: transform 0.2s ease, filter 0.2s ease;
		filter: grayscale(0.2) opacity(0.85);
	}

	.standards-logos a:hover .standard-logo {
		transform: translateY(-2px);
		filter: grayscale(0) opacity(1);
	}

	.badge-info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.badge-title {
		font-size: 0.9rem;
		color: var(--text-normal, #e4e4e7);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.badge-desc {
		font-size: 0.8rem;
		color: var(--text-muted);
		opacity: 0.85;
		font-weight: 400;
	}

	.icon-field {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 0;
		overflow: hidden;
	}

	.float-icon {
		position: absolute;
		opacity: 0.05;
		animation: drift 40s ease-in-out infinite alternate;
	}

	@keyframes drift {
		0%   { transform: translate(0, 0) rotate(0deg); }
		25%  { transform: translate(15px, -20px) rotate(8deg); }
		50%  { transform: translate(-10px, 10px) rotate(-5deg); }
		75%  { transform: translate(20px, 15px) rotate(12deg); }
		100% { transform: translate(-5px, -15px) rotate(-3deg); }
	}

	@media (max-width: 768px) {
		.float-icon { display: none; }
	}
</style>
